rules_version = '2';

// Reguły bezpieczeństwa bazy. Wklej je w konsoli Firebase:
// Firestore Database → Reguły → zastąp całość → Opublikuj.
service cloud.firestore {
  match /databases/{database}/documents {

    // Administratorzy rozpoznawani po adresie e-mail konta (Authentication → Users).
    // Nowego admina: załóż mu konto w Authentication i dopisz jego e-mail do listy (małymi literami).
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'adam.j@topart.pl',
        'michal.c@topart.pl',
        'irena.d@topart.pl'
      ];
    }

    function isDay(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Pozycje katalogu: każdy czyta, zmienia tylko admin
    match /pozycje/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.name is string
        && !('price' in request.resource.data)
        && (!('img' in request.resource.data) || request.resource.data.img.size() < 950000);
      allow delete: if isAdmin();
    }

    // Ceny: tylko dla adminów. Klienci ich nie widzą.
    match /ceny/{id} {
      allow read, write: if isAdmin();
    }

    // Ustawienia (dni, dopłata, VAT): każdy czyta, zmienia tylko admin
    match /ustawienia/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Zapytania klientów: każdy może WYSŁAĆ, tylko admin czyta i zmienia
    match /zapytania/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['created','status','subject','lang','name','company','email','phone','event','size','notes','days','items','body',
             'dateFrom','dateTo','resFrom','resTo'])
        && isDay(request.resource.data.dateFrom) && isDay(request.resource.data.dateTo)
        && isDay(request.resource.data.resFrom) && isDay(request.resource.data.resTo)
        && request.resource.data.created == request.time
        && request.resource.data.status == 'nowe'
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 200
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.body is string && request.resource.data.body.size() < 30000
        && request.resource.data.notes is string && request.resource.data.notes.size() < 5000
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 300;
      allow read, update, delete: if isAdmin();
    }

    // Rezerwacje: każdy widzi (bez danych osobowych: tylko wydarzenie, daty i liczby sztuk).
    // Klient tworzy WSTĘPNĄ rezerwację razem ze swoim zapytaniem; status zmienia tylko admin.
    match /rezerwacje/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['created','status','event','items','dateFrom','dateTo','resFrom','resTo'])
        && request.resource.data.created == request.time
        && request.resource.data.status == 'wstepna'
        && request.resource.data.event is string && request.resource.data.event.size() < 200
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 300
        && isDay(request.resource.data.dateFrom) && isDay(request.resource.data.dateTo)
        && isDay(request.resource.data.resFrom) && isDay(request.resource.data.resTo)
        && existsAfter(/databases/$(database)/documents/zapytania/$(id));
      allow create, update, delete: if isAdmin();
    }
  }
}
